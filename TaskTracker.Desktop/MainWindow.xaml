<Window x:Class="TaskTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskTracker" Height="600" Width="1000"
        Background="#F5F7FA" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: кнопка + статистика + календарь -->
        <Border Grid.Row="0" Background="White" Margin="10,10,10,0" Padding="12" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="+ New task" Click="AddTask_Click" 
                        Background="#4F46E5" Foreground="White" 
                        Height="32" MinWidth="120" 
                        BorderThickness="0" Margin="0,0,10,0"/>

                <!-- Статистика -->
                <TextBlock Text="Status:" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#6C47FF" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding ToDoCount}" Foreground="White"/>
                </Border>
                <Border Background="#8B2F97" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding InProgressCount}" Foreground="White"/>
                </Border>
                <Border Background="#3A506B" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding DoneCount}" Foreground="White"/>
                </Border>
                <Border Background="#E53E3E" Padding="8,4" CornerRadius="4" Margin="0,0,15,0">
                    <TextBlock Text="{Binding OverdueCount}" Foreground="White"/>
                </Border>

                <!-- Квадранты -->
                <TextBlock Text="Matrix:" FontWeight="SemiBold" Foreground="#2D3748" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#FF6B6B" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding UrgentImportantCount}" Foreground="White"/>
                </Border>
                <Border Background="#8B5CF6" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding NotUrgentImportantCount}" Foreground="White"/>
                </Border>
                <Border Background="#6EE7B7" Padding="8,4" CornerRadius="4" Margin="0,0,5,0">
                    <TextBlock Text="{Binding UrgentNotImportantCount}" Foreground="White"/>
                </Border>
                <Border Background="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,15,0">
                    <TextBlock Text="{Binding NotUrgentNotImportantCount}" Foreground="White"/>
                </Border>

                <!-- Кнопка календаря -->
                <Button Content="Calendar" Click="ShowCalendar_Click" 
                        Background="#4F46E5" Foreground="White" 
                        Height="32" MinWidth="100" 
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Основной контент с тремя колонками -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- To Do -->
            <Border Grid.Column="0" Margin="10" Background="#6C47FF" CornerRadius="8">
                <DockPanel LastChildFill="True" Margin="12">
                    <TextBlock Text="To Do" FontSize="18" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                    <ListBox Name="ToDoList" DisplayMemberPath="Title"
                             AllowDrop="True"
                             DragEnter="TaskList_DragEnter"
                             Drop="TaskList_Drop"
                             PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="White" 
                                                    BorderBrush="#E0E0E0" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- In Progress -->
            <Border Grid.Column="1" Margin="10" Background="#8B2F97" CornerRadius="8">
                <DockPanel LastChildFill="True" Margin="12">
                    <TextBlock Text="In Progress" FontSize="18" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                    <ListBox Name="InProgressList" DisplayMemberPath="Title"
                             AllowDrop="True"
                             DragEnter="TaskList_DragEnter"
                             Drop="TaskList_Drop"
                             PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="White" 
                                                    BorderBrush="#E0E0E0" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Done -->
            <Border Grid.Column="2" Margin="10" Background="#3A506B" CornerRadius="8">
                <DockPanel LastChildFill="True" Margin="12">
                    <TextBlock Text="Done" FontSize="18" FontWeight="SemiBold" Foreground="White" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                    <ListBox Name="DoneList" DisplayMemberPath="Title"
                             AllowDrop="True"
                             DragEnter="TaskList_DragEnter"
                             Drop="TaskList_Drop"
                             PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="White" 
                                                    BorderBrush="#E0E0E0" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>