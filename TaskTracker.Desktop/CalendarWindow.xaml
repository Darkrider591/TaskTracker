<Window x:Class="TaskTracker.Desktop.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task calendar" Height="400" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Deadline tasks" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ListView x:Name="TasksListView" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                    <GridViewColumn Header="Term" DisplayMemberBinding="{Binding DueDate, StringFormat=d}" Width="100"/>
                    <GridViewColumn Header="Quadrant" DisplayMemberBinding="{Binding Quadrant}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>